<IfModule mod_headers.c>
    # Ordinary static assets: cache for one day
    <FilesMatch "\.(?:css|js|json|wasm|png|jpe?g|gif|svg|ico|webp|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>

    # HTML entry points and configuration must be checked for updates
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    <FilesMatch "^(?:config(?:\..+)?\.json|version|sw\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Translation files retain stable URLs between releases
    SetEnvIf Request_URI "/i18n/" element_no_cache
    Header set Cache-Control "no-cache" env=element_no_cache

    # Element's bundle directory contains a release/content hash
    SetEnvIf Request_URI "/bundles/[0-9a-f]+/" element_immutable
    Header set Cache-Control "public, max-age=31536000, immutable" env=element_immutable
</IfModule>